  "advanced_ratios" [label=<<table border=\"0\" cellborder=\"1\" cellspacing=\"0\"><tr><td bgcolor=\"lightgray\" colspan=\"2\"><b>advanced_ratios</b></td></tr><tr><td align=\"left\"><b>PK</b> scheme_id</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">sharpe_ratio</td><td align=\"left\">REAL</td></tr><tr><td align=\"left\">sortino_ratio</td><td align=\"left\">REAL</td></tr><tr><td align=\"left\">alpha</td><td align=\"left\">REAL</td></tr><tr><td align=\"left\">beta</td><td align=\"left\">REAL</td></tr><tr><td align=\"left\">standard_deviation</td><td align=\"left\">REAL</td></tr><tr><td align=\"left\">information_ratio</td><td align=\"left\">REAL</td></tr><tr><td align=\"left\">risk_rating</td><td align=\"left\">INTEGER</td></tr><tr><td align=\"left\">risk</td><td align=\"left\">TEXT</td></tr></table>>];
  "expense_exit_tax" [label=<<table border=\"0\" cellborder=\"1\" cellspacing=\"0\"><tr><td bgcolor=\"lightgray\" colspan=\"2\"><b>expense_exit_tax</b></td></tr><tr><td align=\"left\"><b>PK</b> scheme_id</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">expense_ratio</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">exit_load</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">stamp_duty</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">tax_implication</td><td align=\"left\">TEXT</td></tr></table>>];
  "returns_meta" [label=<<table border=\"0\" cellborder=\"1\" cellspacing=\"0\"><tr><td bgcolor=\"lightgray\" colspan=\"2\"><b>returns_meta</b></td></tr><tr><td align=\"left\"><b>PK</b> scheme_id</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">category</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">active_type</td><td align=\"left\">TEXT</td></tr></table>>];
  "return_periods" [label=<<table border=\"0\" cellborder=\"1\" cellspacing=\"0\"><tr><td bgcolor=\"lightgray\" colspan=\"2\"><b>return_periods</b></td></tr><tr><td align=\"left\"><b>PK</b> id</td><td align=\"left\">INTEGER</td></tr><tr><td align=\"left\">scheme_id</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">period_label</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">ord</td><td align=\"left\">INTEGER</td></tr></table>>];
  "return_values" [label=<<table border=\"0\" cellborder=\"1\" cellspacing=\"0\"><tr><td bgcolor=\"lightgray\" colspan=\"2\"><b>return_values</b></td></tr><tr><td align=\"left\"><b>PK</b> id</td><td align=\"left\">INTEGER</td></tr><tr><td align=\"left\">scheme_id</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">metric_label</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">period_label</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">value</td><td align=\"left\">TEXT</td></tr></table>>];
