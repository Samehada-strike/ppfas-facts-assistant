digraph G {
  graph [rankdir=LR];
  node [shape=plaintext];

  "schemes" [label=<<table border=\"0\" cellborder=\"1\" cellspacing=\"0\"><tr><td bgcolor=\"lightgray\" colspan=\"2\"><b>schemes</b></td></tr><tr><td align=\"left\"><b>PK</b> scheme_id</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">scheme_name</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">category</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">sub_category</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">risk</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">amc_name</td><td align=\"left\">TEXT</td></tr></table>>];
  "nav_summary" [label=<<table border=\"0\" cellborder=\"1\" cellspacing=\"0\"><tr><td bgcolor=\"lightgray\" colspan=\"2\"><b>nav_summary</b></td></tr><tr><td align=\"left\"><b>PK</b> scheme_id</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">nav_value_raw</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">nav_as_on</td><td align=\"left\">TEXT</td></tr></table>>];
