  "fund_managers" [label=<<table border=\"0\" cellborder=\"1\" cellspacing=\"0\"><tr><td bgcolor=\"lightgray\" colspan=\"2\"><b>fund_managers</b></td></tr><tr><td align=\"left\"><b>PK</b> id</td><td align=\"left\">INTEGER</td></tr><tr><td align=\"left\">scheme_id</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">manager_name</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">tenure</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">education</td><td align=\"left\">TEXT</td></tr><tr><td align=\"left\">experience</td><td align=\"left\">TEXT</td></tr></table>>];

  "nav_summary" -> "schemes" [label="scheme_id→scheme_id"];
  "minimum_investment" -> "schemes" [label="scheme_id→scheme_id"];
  "advanced_ratios" -> "schemes" [label="scheme_id→scheme_id"];
  "expense_exit_tax" -> "schemes" [label="scheme_id→scheme_id"];
  "returns_meta" -> "schemes" [label="scheme_id→scheme_id"];
  "return_periods" -> "schemes" [label="scheme_id→scheme_id"];
  "return_values" -> "schemes" [label="scheme_id→scheme_id"];
  "holdings" -> "schemes" [label="scheme_id→scheme_id"];
  "fund_managers" -> "schemes" [label="scheme_id→scheme_id"];
